{
  "$defs": {
    "ControlConfig": {
      "additionalProperties": false,
      "description": "Execution control configuration.",
      "properties": {
        "timeout": {
          "default": 30,
          "description": "Execution timeout in seconds",
          "maximum": 3600,
          "minimum": 1,
          "title": "Timeout",
          "type": "integer"
        },
        "retry": {
          "default": 1,
          "description": "Retry count on failure",
          "maximum": 10,
          "minimum": 0,
          "title": "Retry",
          "type": "integer"
        },
        "interrupt": {
          "default": true,
          "description": "Allow execution interruption",
          "title": "Interrupt",
          "type": "boolean"
        },
        "breakpoint_allowed": {
          "default": true,
          "description": "Allow breakpoints",
          "title": "Breakpoint Allowed",
          "type": "boolean"
        },
        "mockable": {
          "default": true,
          "description": "Allow mock execution",
          "title": "Mockable",
          "type": "boolean"
        },
        "repair": {
          "default": 2,
          "description": "Bounded repair budget: re-asks the model with the validation error attached when JSON output fails the output schema (0 disables)",
          "maximum": 5,
          "minimum": 0,
          "title": "Repair",
          "type": "integer"
        },
        "backoff_base": {
          "default": 0.0,
          "description": "Exponential backoff base in seconds for transient retries (delay = base * 2**attempt, capped at 30s; 0 = no wait)",
          "maximum": 60.0,
          "minimum": 0.0,
          "title": "Backoff Base",
          "type": "number"
        },
        "max_workers": {
          "default": 2,
          "description": "Max parallel steps within one DAG level",
          "maximum": 8,
          "minimum": 1,
          "title": "Max Workers",
          "type": "integer"
        }
      },
      "title": "ControlConfig",
      "type": "object"
    },
    "ExecuteConfig": {
      "additionalProperties": false,
      "description": "Execution configuration for skill.",
      "properties": {
        "prompt_template": {
          "description": "Prompt template with variables",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Prompt Template",
          "type": "string"
        },
        "steps": {
          "description": "Execution steps",
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Steps",
          "type": "array"
        },
        "temperature": {
          "default": 0.1,
          "description": "LLM temperature parameter",
          "maximum": 2.0,
          "minimum": 0.0,
          "title": "Temperature",
          "type": "number"
        },
        "model": {
          "default": "gpt-4o-mini",
          "description": "LLM model name",
          "maxLength": 100,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "tools": {
          "description": "Required tools",
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Tools",
          "type": "array"
        },
        "fallback": {
          "description": "Fallback strategies",
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Fallback",
          "type": "array"
        },
        "requires_approval": {
          "default": false,
          "description": "If true, the runtime pauses the run for human approval before executing this skill",
          "title": "Requires Approval",
          "type": "boolean"
        },
        "depends_on": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": "DAG edges for composite sub-skills: tool name -> names of sub-skills that must complete before it starts. Empty = declared order.",
          "maxProperties": 20,
          "title": "Depends On",
          "type": "object"
        }
      },
      "required": [
        "prompt_template"
      ],
      "title": "ExecuteConfig",
      "type": "object"
    },
    "OutputConfig": {
      "additionalProperties": false,
      "description": "Output configuration for skill.",
      "properties": {
        "format": {
          "default": "json",
          "description": "Output format",
          "pattern": "^(json|yaml|text|markdown)$",
          "title": "Format",
          "type": "string"
        },
        "params": {
          "description": "Output parameters",
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Params",
          "type": "array"
        },
        "validation_rules": {
          "description": "Output validation rules",
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Validation Rules",
          "type": "array"
        },
        "schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional full JSON Schema for the output document; when absent a permissive object schema is derived from params",
          "title": "Schema"
        }
      },
      "title": "OutputConfig",
      "type": "object"
    },
    "ParamType": {
      "description": "Allowed JSON types for skill parameters.\n\nStrict enumeration replaces the previous free-form string so typos\nsuch as ``strin`` are rejected at validation time.",
      "enum": [
        "string",
        "number",
        "integer",
        "boolean",
        "object",
        "array"
      ],
      "title": "ParamType",
      "type": "string"
    },
    "SkillCategory": {
      "description": "Skill category enumeration.",
      "enum": [
        "atomic",
        "composite",
        "domain",
        "governance"
      ],
      "title": "SkillCategory",
      "type": "string"
    },
    "SkillInputConfig": {
      "additionalProperties": false,
      "description": "Skill input configuration.",
      "properties": {
        "params": {
          "description": "Input parameters",
          "items": {
            "$ref": "#/$defs/SkillParam"
          },
          "maxItems": 50,
          "title": "Params",
          "type": "array"
        }
      },
      "title": "SkillInputConfig",
      "type": "object"
    },
    "SkillMeta": {
      "additionalProperties": false,
      "description": "Skill metadata configuration.",
      "properties": {
        "name": {
          "description": "Skill display name",
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "default": "1.1.0",
          "description": "Semantic version (e.g., 1.1.0)",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/SkillCategory",
          "description": "Skill category"
        },
        "domain": {
          "default": "general",
          "description": "Skill domain",
          "maxLength": 100,
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "description": {
          "description": "Skill description",
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "tags": {
          "description": "Skill tags for categorization",
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Tags",
          "type": "array"
        },
        "owner": {
          "default": "community",
          "description": "Skill owner",
          "maxLength": 100,
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        }
      },
      "required": [
        "name",
        "category",
        "description"
      ],
      "title": "SkillMeta",
      "type": "object"
    },
    "SkillParam": {
      "additionalProperties": false,
      "description": "Skill input parameter definition.\n\nConstraints (``enum`` / ``minimum`` … / ``pattern`` / ``nullable``) mirror\nJSON Schema keywords and are enforced by the runtime before any model\ncall; they also feed the parameter's JSON Schema fragment.",
      "properties": {
        "name": {
          "description": "Parameter name",
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ParamType",
          "description": "Parameter JSON type"
        },
        "required": {
          "default": true,
          "description": "Whether parameter is required",
          "title": "Required",
          "type": "boolean"
        },
        "description": {
          "default": "",
          "description": "Parameter description",
          "maxLength": 500,
          "title": "Description",
          "type": "string"
        },
        "default": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default value if not required",
          "title": "Default"
        },
        "items_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParamType"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Element type when type=array, used to build nested JSON Schema"
        },
        "schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional full JSON Schema override for this parameter",
          "title": "Schema"
        },
        "enum": {
          "anyOf": [
            {
              "items": {},
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Allowed values (JSON Schema enum)",
          "title": "Enum"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inclusive lower bound (number/integer)",
          "title": "Minimum"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inclusive upper bound (number/integer)",
          "title": "Maximum"
        },
        "min_length": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Min length (string/array)",
          "title": "Min Length"
        },
        "max_length": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Max length (string/array)",
          "title": "Max Length"
        },
        "pattern": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Regex constraint (string)",
          "title": "Pattern"
        },
        "nullable": {
          "default": false,
          "description": "Whether an explicit null value is allowed",
          "title": "Nullable",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "SkillParam",
      "type": "object"
    },
    "SourceTrace": {
      "additionalProperties": false,
      "description": "Source traceability information.",
      "properties": {
        "sop_name": {
          "description": "Source SOP name",
          "maxLength": 200,
          "minLength": 1,
          "title": "Sop Name",
          "type": "string"
        },
        "sop_path": {
          "default": "",
          "description": "Source SOP file path",
          "maxLength": 500,
          "title": "Sop Path",
          "type": "string"
        },
        "step_index": {
          "description": "Step index in source SOP",
          "minimum": 0,
          "title": "Step Index",
          "type": "integer"
        },
        "raw_step": {
          "description": "Raw step content",
          "maxLength": 2000,
          "minLength": 1,
          "title": "Raw Step",
          "type": "string"
        },
        "context": {
          "default": "",
          "description": "Surrounding SOP context (headings, constraints, conditions) preserved from the source document so nothing is silently lost",
          "maxLength": 8000,
          "title": "Context",
          "type": "string"
        }
      },
      "required": [
        "sop_name",
        "step_index",
        "raw_step"
      ],
      "title": "SourceTrace",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Main uSkill model definition.",
  "properties": {
    "skill_id": {
      "description": "Unique skill identifier",
      "maxLength": 200,
      "minLength": 1,
      "title": "Skill Id",
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/SkillMeta",
      "description": "Skill metadata"
    },
    "input": {
      "$ref": "#/$defs/SkillInputConfig",
      "description": "Input configuration"
    },
    "execute": {
      "$ref": "#/$defs/ExecuteConfig",
      "description": "Execution configuration"
    },
    "output": {
      "$ref": "#/$defs/OutputConfig",
      "description": "Output configuration"
    },
    "control": {
      "$ref": "#/$defs/ControlConfig",
      "description": "Control configuration"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceTrace"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Source traceability. Optional so standalone, hand-authored skills do not need to fake an SOP origin."
    }
  },
  "required": [
    "skill_id",
    "meta",
    "input",
    "execute",
    "output",
    "control"
  ],
  "title": "USkill",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhubao315.github.io/uSkill/schema/v1.1.0.json"
}